# Copy this file to .env and replace placeholder values.
# .env is ignored by Git.

# Optional production rewarded-ad unit IDs.
# Debug builds automatically use Google's test ad units.
# Also replace the native application IDs before release:
#   android/app/src/main/AndroidManifest.xml: com.google.android.gms.ads.APPLICATION_ID
#   ios/Runner/Info.plist: GADApplicationIdentifier
# ADMOB_REWARDED_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# ADMOB_REWARDED_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
